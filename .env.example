# Browser (public — committed anon key is normal for Supabase PWAs)
# VITE_/import meta: see src/js/config/supabase.js

# Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Fail-closed: comma-separated browser origins allowed to call proxies
PITH_CORS_ORIGINS=http://localhost:3000,https://pith.pedrojon.com

# Fail-closed: comma-separated auth.users UUIDs allowed to use platform LLM + cache writes.
# Empty = deny all unless LLM_PROXY_ALLOW_ALL=true
LLM_PROXY_ALLOWED_USER_IDS=

# Optional escape for local/dev only (never set true in production)
# LLM_PROXY_ALLOW_ALL=true

# Optional
LLM_PROXY_MAX_PER_HOUR=180
LLM_PROXY_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner,gemini-3.5-flash,gemini-embedding-001
